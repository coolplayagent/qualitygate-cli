{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qualitygate:agent-obligation:1",
  "title": "Source-bound consuming agent obligation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "source",
    "required",
    "scope",
    "triggers",
    "must",
    "must_not",
    "enforcement"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document",
        "section",
        "content_hash"
      ],
      "properties": {
        "document": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "content_hash": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "required": {
      "type": "boolean"
    },
    "adoption": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "id",
        "reviewer",
        "reference",
        "resolution",
        "rationale",
        "binding_digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "resolution": {
          "enum": [
            "initial_mapping",
            "rule_updated",
            "rule_unchanged"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "binding_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roles",
        "tasks"
      ],
      "properties": {
        "roles": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "tasks": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "start",
          "repair",
          "resume",
          "handoff",
          "before_tool",
          "after_change",
          "before_delivery"
        ]
      }
    },
    "must": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "must_not": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "enforcement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "instruction"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "checks"
          ],
          "properties": {
            "kind": {
              "const": "checks"
            },
            "checks": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "control"
          ],
          "properties": {
            "kind": {
              "const": "host"
            },
            "control": {
              "enum": [
                "prompt_injection",
                "policy_integrity",
                "final_full_check",
                "immutable_delivery",
                "tool_authorization",
                "final_response",
                "in_process_context_recovery"
              ]
            }
          }
        }
      ]
    }
  },
  "anyOf": [
    {
      "properties": {
        "must": {
          "minItems": 1
        }
      }
    },
    {
      "properties": {
        "must_not": {
          "minItems": 1
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
