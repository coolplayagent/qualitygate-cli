load("//bazel:rust_deps.bzl", "aliases", "all_crate_deps", "crate_edition", "package_rustc_env")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["tests/common/http.rs"])

filegroup(
    name = "packaged_rules",
    srcs = glob(["skills/qualitygate-cli/references/rules/**/*.yaml"]),
)

filegroup(
    name = "rule_schemas",
    srcs = glob(["skills/qualitygate-cli/references/schemas/*.json"]),
)

filegroup(
    name = "tool_fact_reference_assets",
    srcs = [
        "skills/qualitygate-cli/references/operators-v4.md",
        "skills/qualitygate-cli/references/examples/operators-v4.yaml",
    ],
)

filegroup(
    name = "fixture_assets",
    srcs = glob(["fixtures/**/*.json"]),
)

filegroup(
    name = "engineering_standard_assets",
    srcs = glob([
        "knowledge/best-practices/engineering-standards/lifecycle-rule-matrix*.yaml",
    ]) + [
        "knowledge/best-practices/engineering-standards/registry.yaml",
    ],
)

alias(
    name = "qualitygate_lib",
    actual = "//src/qualitygate:qualitygate_lib",
)

alias(
    name = "qualitygate",
    actual = "//src/qualitygate:qualitygate",
)

rust_binary(
    name = "doctor_probe",
    srcs = ["tests/doctor/native_probe.rs"],
    edition = crate_edition(),
    testonly = True,
)

rust_test(
    name = "doctor_test",
    crate_root = "tests/doctor.rs",
    srcs = ["tests/doctor.rs", "tests/common/mod.rs"] + glob(["tests/doctor/*.rs"]),
    data = [":qualitygate", ":packaged_rules", ":rule_schemas", ":doctor_probe"],
    env_inherit = ["PATH"],
    rustc_env = dict(
        package_rustc_env(),
        CARGO_BIN_EXE_qualitygate = "$(rootpath :qualitygate)",
        CARGO_MANIFEST_DIR = ".",
        QUALITYGATE_TEST_PROBE = "$(rootpath :doctor_probe)",
    ),
    aliases = aliases(normal = True, normal_dev = True, proc_macro_dev = True),
    edition = crate_edition(),
    deps = [":qualitygate_lib"] + all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
)

test_suite(
    name = "unit_tests",
    tests = [
        "//src/qualitygate:env_unit_tests",
        "//src/qualitygate:paths_unit_tests",
        "//src/qualitygate:adapters_unit_tests",
        "//src/qualitygate:application_unit_tests",
        "//src/qualitygate:config_unit_tests",
        "//src/qualitygate:domain_unit_tests",
        "//src/qualitygate:interfaces_unit_tests",
        "//src/qualitygate/net:unit_tests",
        "//src/qualitygate/runner:unit_tests",
        "//src/qualitygate/snapshot:unit_tests",
    ],
)

rust_test(
    name = "bazel_contract_test",
    crate_root = "tests/bazel.rs",
    srcs = ["tests/bazel.rs"],
    compile_data = [
        ".bazelrc",
        ".bazelignore",
        ".bazelversion",
        "BUILD.bazel",
        "Cargo.lock",
        "Cargo.toml",
        "MODULE.bazel",
        "MODULE.bazel.lock",
        "qualitygate.yaml",
        "rust-toolchain.toml",
        "skills/qualitygate-cli/references/schemas/tool-facts-v1.schema.json",
        "//bazel:BUILD.bazel",
        "//bazel:rust_deps.bzl",
        "//src/qualitygate:BUILD.bazel",
        "//src/qualitygate/report_evidence/tool_reports:BUILD.bazel",
        "//src/qualitygate/source_analysis/syntax:BUILD.bazel",
        "//src/qualitygate/check_planning/discovery:BUILD.bazel",
        "//src/qualitygate/net:BUILD.bazel",
        "//src/qualitygate/runner:BUILD.bazel",
        "//src/qualitygate/snapshot:BUILD.bazel",
    ],
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    edition = crate_edition(),
    deps = [":qualitygate_lib"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
)

alias(
    name = "qualitygate-tool-bridge",
    actual = "//src/qualitygate:qualitygate-tool-bridge",
)

filegroup(
    name = "production_binaries",
    srcs = [":qualitygate", ":qualitygate-tool-bridge"],
)

rust_test(
    name = "tool_bridge_test",
    crate_root = "tests/tool_bridge.rs",
    srcs = ["tests/tool_bridge.rs"],
    data = [":qualitygate-tool-bridge"],
    rustc_env = {
        "CARGO_BIN_EXE_qualitygate-tool-bridge": "$(rootpath :qualitygate-tool-bridge)",
    },
    edition = crate_edition(),
    deps = ["@crates//:serde_json", "@crates//:tempfile"],
)
