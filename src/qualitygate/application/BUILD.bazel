load("//bazel:rust_deps.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob(["*.rs"]),
)

rust_library(
    name = "application",
    crate_name = "qualitygate_application",
    crate_root = "bazel_lib.rs",
    srcs = [":sources"],
    aliases = aliases(),
    edition = crate_edition(),
    deps = [
        "//src/qualitygate/adapters",
        "//src/qualitygate/config",
        "//src/qualitygate/domain",
        "//src/qualitygate/env",
        "//src/qualitygate/net",
        "//src/qualitygate/paths",
        "//src/qualitygate/runner",
        "//src/qualitygate/snapshot",
    ] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "unit_tests",
    crate = ":application",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    edition = crate_edition(),
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)
